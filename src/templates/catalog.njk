{% import "catalog-data.njk" as catalog %}
{# Каталог: слева заголовок и выбор типа техники, справа фильтр и прокручиваемая сетка карточек. #}
{# Фильтрация и чтение параметров из адреса — в scripts/modules/catalog.ts #}
<section class="catalog">
  <aside class="catalog__aside">
    <div class="catalog__intro">
      <h1 class="catalog__title">Каталог</h1>
      <p class="catalog__count" aria-live="polite" data-catalog-count>
        Найдено: {{ catalog.items | length }}
      </p>
      <button class="catalog__reset" type="reset" form="catalog-filter" data-catalog-reset>
        Сбросить фильтры
      </button>
    </div>
    <div class="catalog__types" role="radiogroup" aria-label="Тип техники">
      <label class="catalog__type">
        <input
          class="catalog__type-input"
          type="radio"
          name="type"
          value="semitrailer"
          form="catalog-filter"
        />
        <span class="catalog__type-body">
          <span class="catalog__type-title">Полуприцепы-<br />цистерны</span>
          <svg class="catalog__type-image catalog__type-image--ppc" aria-hidden="true">
            <use href="#icon-ppc"></use>
          </svg>
        </span>
      </label>
      <label class="catalog__type">
        <input
          class="catalog__type-input"
          type="radio"
          name="type"
          value="chassis"
          form="catalog-filter"
        />
        <span class="catalog__type-body">
          <span class="catalog__type-title">Цистерны<br />на шасси</span>
          <svg class="catalog__type-image catalog__type-image--shassi" aria-hidden="true">
            <use href="#icon-shassi"></use>
          </svg>
        </span>
      </label>
    </div>
  </aside>
  <div class="catalog__main">
    <form class="catalog__filter" id="catalog-filter" action="/catalog.html" data-catalog-filter>
      {% for group in catalog.groups %}
        <fieldset
          class="catalog__group"
          {% if group.types %}data-catalog-types="{{ group.types }}"{% endif %}
          {{ "hidden disabled" if group.types and group.types != "none" }}
        >
          <legend class="catalog__legend">{{ group.label }}</legend>
          <div class="catalog__options">
            {% for option in group.options %}
              <label class="catalog__option">
                <input
                  class="catalog__option-input"
                  type="checkbox"
                  name="{{ group.name }}"
                  value="{{ option[0] }}"
                />
                <span class="catalog__option-label">{{ option[1] }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>
        {# Объём стоит сразу после наличия, как в эскизе #}
        {% if group.name == "stock" %}
          <fieldset class="catalog__group">
            <legend class="catalog__legend">Объём цистерны</legend>
            <div class="catalog__volume">
              <label class="catalog__volume-field">
                от
                <input
                  class="catalog__volume-input"
                  type="text"
                  name="volume-from"
                  inputmode="numeric"
                />
              </label>
              <label class="catalog__volume-field">
                до
                <input
                  class="catalog__volume-input"
                  type="text"
                  name="volume-to"
                  inputmode="numeric"
                />
                м³
              </label>
            </div>
          </fieldset>
        {% endif %}
      {% endfor %}
    </form>
    <div class="catalog__results" data-catalog-results>
      <ul class="catalog__list">
        {% for item in catalog.items %}
          {% set badge = "В наличии" if item.stock == "in" else "Под заказ" %}
          {% if item.type == "chassis" %}
            {% set baseSpec = ["Шасси", item.chassisLabel] %}
          {% else %}
            {% set baseSpec = ["Количество осей", item.axles] %}
          {% endif %}
          {%
            set product = {
              model: item.model,
              type: item.typeLabel,
              image: item.image,
              focus: item.focus,
              badge: badge,
              specs: [["Объём", item.volume ~ " м³"], ["Количество секций", item.sections], baseSpec]
            }
          %}
          <li
            class="catalog__item"
            data-catalog-item
            data-type="{{ item.type }}"
            data-purpose="{{ item.purpose }}"
            data-stock="{{ item.stock }}"
            data-volume="{{ item.volume }}"
            data-sections="{{ item.sections }}"
            data-shape="{{ item.shape }}"
            data-suspension="{{ item.suspension }}"
            data-ssu="{{ item.ssu }}"
            data-axle="{{ item.axle }}"
            data-construction="{{ item.construction }}"
            data-chassis="{{ item.chassis }}"
          >
            {% include "product-card.njk" %}
          </li>
        {% endfor %}
      </ul>
      <p class="catalog__empty" hidden data-catalog-empty>
        По этим параметрам техники нет. Измените условия или сбросьте фильтры.
      </p>
    </div>
  </div>
</section>
