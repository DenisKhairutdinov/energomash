{# Каталог: слева на сетке из двух равных половин заголовок и тип техники, #}
{# справа сверху фильтр, под ним прокручиваемая сетка карточек. #}
{# Данные — src/data/catalog.json (переменная catalog), собираются из дампа базы: npm run catalog:import. #}
{# Фильтрация и чтение параметров из адреса — в scripts/modules/catalog.ts #}
<section class="catalog" data-fullpage-section data-fullpage-label="Каталог">
  <div class="catalog__intro">
    <h1 class="catalog__title">Каталог</h1>
  </div>
  <div class="catalog__types" role="radiogroup" aria-label="Тип техники">
    <label class="catalog__type">
      <input
        class="catalog__type-input"
        type="radio"
        name="type"
        value="semitrailer"
        form="catalog-filter"
      />
      <span class="catalog__type-body">
        <span class="catalog__type-head">
          <span class="catalog__type-title">Полуприцепы-<br />цистерны</span>
          <span class="catalog__type-mark" aria-hidden="true"></span>
        </span>
        <svg class="catalog__type-image catalog__type-image--ppc" aria-hidden="true">
          <use href="#icon-ppc"></use>
        </svg>
      </span>
    </label>
    <label class="catalog__type">
      <input
        class="catalog__type-input"
        type="radio"
        name="type"
        value="chassis"
        form="catalog-filter"
      />
      <span class="catalog__type-body">
        <span class="catalog__type-head">
          <span class="catalog__type-title">Цистерны<br />на шасси</span>
          <span class="catalog__type-mark" aria-hidden="true"></span>
        </span>
        <svg class="catalog__type-image catalog__type-image--shassi" aria-hidden="true">
          <use href="#icon-shassi"></use>
        </svg>
      </span>
    </label>
  </div>
  <div class="catalog__main">
    {# Технические параметры (не primary) свёрнуты, пока их не откроют кнопкой или не выберут из адреса #}
    <form
      class="catalog__filter catalog__filter--collapsed"
      id="catalog-filter"
      action="/catalog.html"
      data-catalog-filter
    >
      {# Группа с types относится к одному типу техники и показывается, когда он выбран. #}
      {# Значения, которых нет у выбранного типа, скрывает скрипт #}
      {% macro filterGroup(group) %}
        {% set groupTypes = group.types | join(" ") %}
        {% if group.kind == "range" %}
          <fieldset class="catalog__group">
            <legend class="catalog__legend">{{ group.label }}</legend>
            <div class="catalog__volume">
              <label class="catalog__volume-field">
                от
                <input
                  class="catalog__volume-input"
                  type="text"
                  name="{{ group.name }}-from"
                  inputmode="numeric"
                  maxlength="3"
                  autocomplete="off"
                  placeholder="{{ group.min }}"
                />
              </label>
              <label class="catalog__volume-field">
                до
                <input
                  class="catalog__volume-input"
                  type="text"
                  name="{{ group.name }}-to"
                  inputmode="numeric"
                  maxlength="3"
                  autocomplete="off"
                  placeholder="{{ group.max }}"
                />
                {{ group.unit }}
              </label>
            </div>
          </fieldset>
        {% else %}
          <fieldset
            class="catalog__group"
            data-catalog-group
            {% if groupTypes %}data-catalog-types="{{ groupTypes }}" hidden disabled{% endif %}
          >
            <legend class="catalog__legend">{{ group.label }}</legend>
            <div class="catalog__options">
              {% for option in group.options %}
                <label class="catalog__option" data-catalog-option>
                  <input
                    class="catalog__option-input"
                    type="checkbox"
                    name="{{ group.name }}"
                    value="{{ option.value }}"
                  />
                  <span class="catalog__option-label">{{ option.label }}</span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endif %}
      {% endmacro %}
      {# Основные параметры всегда на виду, технические — в раскрывающейся части #}
      <div class="catalog__primary">
        {% for group in catalog.filters %}
          {% if group.primary %}{{ filterGroup(group) }}{% endif %}
        {% endfor %}
      </div>
      <div class="catalog__extra" data-catalog-extra>
        {% for group in catalog.filters %}
          {% if not group.primary %}{{ filterGroup(group) }}{% endif %}
        {% endfor %}
      </div>
      {# Нижняя полоса: слева раскрытие параметров, справа итог подбора и сброс #}
      <div class="catalog__summary">
        <button class="catalog__more" type="button" aria-expanded="false" data-catalog-more>
          <span data-catalog-more-label>Все параметры</span>
          <span class="catalog__more-count" hidden data-catalog-more-count></span>
        </button>
        <p class="catalog__count" aria-live="polite">
          Найдено:
          <span data-catalog-count>{{ catalog.total }}</span>
        </p>
        <button class="catalog__reset" type="reset" disabled data-catalog-reset>
          Сбросить фильтры
        </button>
      </div>
    </form>
    {# Полоса под фильтром показывает, какая часть списка карточек уже прокручена #}
    <div class="catalog__progress" aria-hidden="true" hidden data-catalog-progress>
      <span class="catalog__progress-bar" data-catalog-progress-bar></span>
    </div>
    <div class="catalog__results" data-catalog-results data-fullpage-scroller="main">
      <ul class="catalog__list" data-catalog-list>
        {# Карточки выводит скрипт: загружает public/data/catalog.json и добавляет порциями по мере прокрутки #}
      </ul>
      {# Метка конца списка: когда она подходит к краю области, добавляется следующая порция #}
      <div class="catalog__sentinel" aria-hidden="true" data-catalog-sentinel></div>
      <p class="catalog__empty" hidden data-catalog-empty>
        По этим параметрам техники нет. Измените условия или сбросьте фильтры.
      </p>
      <p class="catalog__empty" hidden data-catalog-error>
        Не удалось загрузить каталог. Обновите страницу.
      </p>
    </div>
    {# Заготовка карточки: скрипт копирует её и подставляет данные модели #}
    <template data-catalog-template>
      <li class="catalog__item">
        {% set product = { template: true } %}
        {% include "product-card.njk" %}
      </li>
    </template>
  </div>
</section>
