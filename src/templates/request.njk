{# Заявка: слева — к кому и зачем обращаться, рядом — прямые контакты для тех, кому проще позвонить, #}
{# справа — форма на две колонки. Заменяет прежний блок cta.njk (файл оставлен для сравнения) #}
<section class="request" data-reveal-group>
  <div class="request__intro" data-reveal>
    <h2 class="request__title">Готовы обсудить вашу задачу?</h2>
    <p class="request__description">
      Расскажите, какая техника вам необходима – рассчитаем стоимость, подберём подходящую модель и
      комплектацию, ответим на вопросы по срокам производства и поставки.
    </p>
  </div>
  <div class="request__direct" data-reveal>
    <span class="request__label">Или свяжитесь напрямую</span>
    <a class="request__phone" href="tel:88001012200">8 (800) 101-22-00</a>
    <a class="request__mail" href="mailto:1@bik55.ru">1@bik55.ru</a>
    <ul class="request__links">
      <li>
        <a
          class="request__link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Написать в MAX"
        >
          <svg class="request__link-icon" aria-hidden="true">
            <use href="#icon-max"></use>
          </svg>
        </a>
      </li>
      <li>
        <a
          class="request__link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Написать во ВКонтакте"
        >
          <svg class="request__link-icon" aria-hidden="true">
            <use href="#icon-vk"></use>
          </svg>
        </a>
      </li>
    </ul>
  </div>
  {# Поля как в окне заявки: подпись над полем, телефон по маске. Обязателен только телефон (отмечен *), #}
  {# остальное необязательно, кроме согласия на обработку данных. Проверка и ошибки — scripts/modules/forms/form.ts #}
  <form class="request__form" action="#" method="post" novalidate data-request-form data-reveal>
    <label class="request__group">
      <span class="request__legend">Ваше имя</span>
      <input class="request__field" type="text" name="name" autocomplete="name" />
    </label>
    <label class="request__group">
      <span class="request__legend"
        >Телефон <span class="request__required" aria-hidden="true">*</span></span
      >
      <input
        class="request__field"
        type="tel"
        name="phone"
        inputmode="tel"
        autocomplete="tel"
        placeholder="+7 (___) ___-__-__"
        aria-required="true"
        aria-describedby="request-error-phone"
      />
      <span class="request__error" id="request-error-phone" hidden data-form-error="phone"></span>
    </label>
    <label class="request__group">
      <span class="request__legend">Email</span>
      <input
        class="request__field"
        type="email"
        name="email"
        autocomplete="email"
        aria-describedby="request-error-email"
      />
      <span class="request__error" id="request-error-email" hidden data-form-error="email"></span>
    </label>
    <label class="request__group">
      <span class="request__legend">Модель или тип техники</span>
      <input class="request__field" type="text" name="model" />
    </label>
    <label class="request__group request__group--comment">
      <span class="request__legend">Комментарий</span>
      <textarea class="request__field request__field--comment" name="comment"></textarea>
    </label>
    <div class="request__footer">
      {% set consentId = "request" %}
      {% include "consent.njk" %}
      <button class="request__submit" type="submit">Отправить заявку</button>
    </div>
  </form>
</section>
