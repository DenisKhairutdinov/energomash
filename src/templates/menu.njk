{# currentPage задаётся на странице в виде "раздел" или "раздел/подраздел" #}
{% set currentPath = (currentPage or "").split("/") %}
{# Рекурсивный вывод подменю: глубина вложенности не ограничена. urlSuffix дописывается ко всем ссылкам ветки #}
{% macro submenu(items, activeId, nested, urlSuffix) %}
  <div class="menu__dropdown {{ 'menu__dropdown--nested' if nested }}">
    <ul class="menu__sublist">
      {% for item in items %}
        <li class="menu__subitem">
          <a
            class="menu__sublink {{ 'menu__sublink--active' if item.id == activeId }}"
            href="{{ item.url }}{{ urlSuffix }}"
            {% if item.children %}aria-haspopup="true"{% endif %}
          >
            <span>{{ item.title }}</span>
            {% if item.children %}
              <svg class="menu__arrow" aria-hidden="true">
                <use href="#icon-expand-right"></use>
              </svg>
            {% endif %}
          </a>
          {% if item.children %}
            {{ submenu(item.children, "", true, urlSuffix) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endmacro %}
<nav class="menu" aria-label="Основное меню">
  <ul class="menu__list">
    {% for item in menuItems %}
      <li class="menu__item">
        <a
          class="menu__link {{ 'menu__link--accent' if item.accent }} {{ 'menu__link--active' if item.id == currentPath[0] }}"
          href="{{ item.url }}"
          {% if item.id == currentPage %}aria-current="page"{% endif %}
        >
          {{ item.title }}
        </a>
        {% if item.children %}
          {{ submenu(item.children, currentPath[1] if item.id == currentPath[0] else "", false, item.urlSuffix or "") }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
