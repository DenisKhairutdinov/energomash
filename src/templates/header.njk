<header class="header" data-header>
  <div class="header__main">
    <a class="header__logo" href="/" aria-label="Энергомаш — на главную">
      <img src="/src/assets/images/logo.svg" width="208" height="32" alt="Энергомаш" />
    </a>
    {% include "menu.njk" %}
  </div>
  <div class="header__aside">
    {# Поиск по коду и названию модели: подсказки под полем, Enter без выбора — результаты в каталоге (?q=) #}
    <form
      class="header__search search"
      action="/catalog.html"
      method="get"
      role="search"
      data-search
    >
      <svg class="search__icon" aria-hidden="true">
        <use href="#icon-search"></use>
      </svg>
      <input
        class="search__input"
        type="search"
        name="q"
        placeholder="Код или название модели"
        aria-label="Поиск по коду и названию модели"
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        data-search-input
      />
      <kbd class="search__hint" aria-hidden="true">/</kbd>
      <div
        class="search__results"
        id="search-results"
        role="listbox"
        hidden
        data-search-results
      ></div>
    </form>
    <ul class="header__contacts">
      <li>
        <a class="header__contact" href="tel:88001012200">
          <svg class="header__contact-icon" aria-hidden="true">
            <use href="#icon-phone"></use>
          </svg>
          8 (800) 101-22-00
        </a>
      </li>
      <li>
        <a class="header__contact" href="mailto:1@bik55.ru">
          <svg class="header__contact-icon header__contact-icon--mail" aria-hidden="true">
            <use href="#icon-mail"></use>
          </svg>
          1@bik55.ru
        </a>
      </li>
    </ul>
    <ul class="header__links">
      <li>
        <a class="header__link" href="#" target="_blank" rel="noopener noreferrer" aria-label="MAX">
          <svg class="header__link-icon" aria-hidden="true">
            <use href="#icon-max"></use>
          </svg>
        </a>
      </li>
      <li>
        <a
          class="header__link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ВКонтакте"
        >
          <svg class="header__link-icon" aria-hidden="true">
            <use href="#icon-vk"></use>
          </svg>
        </a>
      </li>
    </ul>
    {# Открывает окно заявки; без скриптов ссылка ведёт на страницу контактов #}
    <a
      class="header__button"
      href="/contacts.html"
      data-modal-open="request"
      data-modal-kind="contact"
      >Связаться</a
    >
  </div>
</header>
