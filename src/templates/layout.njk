<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/src/assets/favicon.svg" />
    <title>{{ pageTitle }}</title>
    <meta name="description" content="" />
    <meta property="og:title" content="" />
    <meta property="og:description" content="" />
    <meta property="og:image" content="#" />
    <meta property="og:url" content="#" />
    <meta property="og:type" content="website" />

    <meta name="theme-color" content="#f8fafcff" />
    <meta name="format-detection" content="telephone=no" />
    {# Класс js нужен стилям: содержимое прячется до анимации только если скрипты работают #}
    <script>
      document.documentElement.classList.add('js');
    </script>
    <link rel="stylesheet" href="/src/styles/main.scss" />
  </head>
  <body>
    {% include "header.njk" %}
    <div id="smooth-wrapper" data-smooth-wrapper>
      <!-- <div class="animated-background" data-animated-background></div> -->
      <div id="smooth-content" data-smooth-content>
        <main class="main">{% block content %}{% endblock %}</main>
        {# Последний «лист» на каждой странице: форма заявки и футер #}
        <div class="page-end" data-fullpage-section data-fullpage-label="Заявка и контакты">
          {% include "cta.njk" %}
          {% include "footer.njk" %}
        </div>
      </div>
    </div>
    <script type="module" src="/src/scripts/main.ts"></script>
  </body>
</html>
