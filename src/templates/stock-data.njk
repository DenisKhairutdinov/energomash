{# Техника в наличии: данные-заглушки (модели, характеристики, фото), позже придут из БД. #}
{# Подключается через import: {% import "stock-data.njk" as stock %}, список — stock.items #}
{# items — подборка для главной (последние поступления), а не весь склад. #}
{# total — сколько моделей в наличии всего; сейчас условное число, придёт из БД вместе с подборкой #}
{% set total = 24 %}
{# Слово «модель» в нужной форме после числа: 1 модель, 3 модели, 24 модели, 120 моделей #}
{% macro models(count) -%}
  {%- set tail = count % 100 -%}
  {%- set last = count % 10 -%}
  {%- if tail > 10 and tail < 20 -%}
    моделей
  {%- elif last == 1 -%}
    модель
  {%- elif last > 1 and last < 5 -%}
    модели
  {%- else -%}
    моделей
  {%- endif -%}
{%- endmacro %}
